<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="VrPanels.uss" />
    <!-- The tablet in the left hand: a bezel round a screen; the training display on the left, the options on the right. -->
    <ui:VisualElement name="tablet" class="tablet">
        <ui:VisualElement name="screen" class="tablet__screen">
            <ui:VisualElement class="tablet__bar" picking-mode="Ignore">
                <ui:Label text="FACTORY TWIN" class="tablet__brand" />
                <ui:Label name="status" text="" class="hud__status tablet__status" />
            </ui:VisualElement>
            <ui:VisualElement class="tablet__body">
                <ui:VisualElement name="hud" class="tablet__display" picking-mode="Ignore">
                    <ui:Label name="now-label" text="LOCKOUT TRAINING" class="hud__label" />
                    <ui:Label name="current" text="" class="hud__current" />
                    <ui:Label name="where" text="" class="hud__where hidden" />
                    <ui:Label name="refusal" text="" class="hud__refusal hidden" />
                    <ui:VisualElement name="next-row" class="hud__next-row hidden" picking-mode="Ignore">
                        <ui:Label text="NEXT" class="hud__label" />
                        <ui:Label name="next" text="" class="hud__next" />
                    </ui:VisualElement>
                    <ui:Label name="prompt" text="" class="hud__prompt hidden" />
                </ui:VisualElement>
                <!-- Fire drill display (VrFireMenu): the fire, the extinguisher in hand, one line of advice. -->
                <ui:VisualElement name="fire-hud" class="tablet__display" picking-mode="Ignore" style="display: none;">
                    <ui:Label text="FIRE SAFETY TRAINING" class="hud__label" />
                    <ui:Label name="fire-line" text="No fire" class="hud__current" />
                    <ui:Label text="IN HAND" class="hud__label" />
                    <ui:Label name="fire-ext" text="" class="hud__where" />
                    <ui:Label name="fire-advice" text="" class="hud__refusal" />
                    <ui:Label text="Simulated fire; training demo, not certified training." class="hud__prompt" />
                </ui:VisualElement>
                <ui:VisualElement name="fire-options" class="tablet__options" style="display: none;">
                    <ui:Label text="START A FIRE" class="menu__group" />
                    <ui:VisualElement name="fire-starts" class="tablet__row tablet__wrap" />
                    <ui:Button name="fire-random" text="Random fire" class="menu__button" />
                    <ui:Label text="EXTINGUISHER" class="menu__group" />
                    <ui:Label text="Take one from the stand by its handle. Other hand: pull the pin, take the hose. Trigger: squeeze." class="hud__prompt" style="white-space: normal; font-size: 13px; margin: 0 0 2px 0;" />
                    <ui:VisualElement class="tablet__row">
                        <ui:Button name="fire-alarm" text="Raise the alarm" class="menu__button menu__button--key tablet__half" />
                        <ui:Button name="fire-goto" text="Go to the fire" class="menu__button tablet__half" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tablet__row">
                        <ui:Button name="fire-station" text="Back to station" class="menu__button tablet__half" />
                        <ui:Button name="ext-none" text="Put it back" class="menu__button tablet__half" />
                    </ui:VisualElement>
                    <ui:Button name="fire-end" text="End fire drill" class="menu__button menu__button--exit" />
                </ui:VisualElement>
                <ui:VisualElement name="main-options" class="tablet__options">
                    <ui:Label text="TRAINING" class="menu__group" />
                    <ui:Button name="menu-training" text="Lockout training" class="menu__button menu__button--key" />
                    <ui:Button name="menu-fire" text="Fire safety training" class="menu__button menu__button--key" />
                    <ui:VisualElement class="tablet__row">
                        <ui:Button name="menu-fail" text="Fail the CNC" class="menu__button tablet__half" />
                        <ui:Button name="menu-reset" text="Safety reset" class="menu__button tablet__half" />
                    </ui:VisualElement>
                    <ui:Label text="GO TO" class="menu__group" />
                    <ui:Button name="menu-go-cell" text="Cell overview" class="menu__button" />
                    <ui:VisualElement class="tablet__row">
                        <ui:Button name="menu-go-station" text="Station" class="menu__button tablet__half" />
                        <ui:Button name="menu-go-cnc" text="CNC isolator" class="menu__button tablet__half" />
                    </ui:VisualElement>
                    <ui:Button name="menu-exit" text="Exit VR" class="menu__button menu__button--exit" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Menu button or Y: show or hide the tablet" class="tablet__hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
