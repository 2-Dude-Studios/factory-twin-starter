/* World-space panels for the headset (M12): the training board and the tablet in the left hand.
   Sizes are in panel pixels: 100 px is one unit, and each document's transform scale sets its real size (board 0.9 m). */
.hidden {
    display: none;
}

/* Training board above the line control station */
.board {
    width: 100%;
    height: 100%;
    padding: 24px 28px;
    background-color: rgb(20, 24, 28);
    border-radius: 14px;
    border-left-width: 8px;
    border-left-color: rgb(255, 174, 13);
}

.board__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.board__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 242, 244);
}

.board__chip {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 4px 14px;
    border-radius: 14px;
    background-color: rgb(70, 78, 86);
    color: rgb(240, 242, 244);
}

.board__chip--ok { background-color: rgb(38, 217, 89); color: rgb(8, 24, 15); }
.board__chip--warn { background-color: rgb(255, 174, 13); color: rgb(29, 22, 0); }
.board__who { font-size: 20px; color: rgb(200, 206, 212); margin-bottom: 14px; }
.board__step { font-size: 22px; color: rgb(160, 168, 176); }
.board__next { font-size: 32px; -unity-font-style: bold; color: rgb(240, 242, 244); white-space: normal; margin: 4px 0 12px 0; }
.board__mistakes { font-size: 22px; color: rgb(160, 168, 176); }
.board__mistakes--some { color: rgb(255, 174, 13); }
.board__status { font-size: 22px; color: rgb(200, 206, 212); margin-top: 14px; }
.board__status--alert { color: rgb(255, 80, 64); -unity-font-style: bold; }
.board__note { font-size: 16px; color: rgb(120, 128, 136); margin-top: 10px; }

.board__progress { flex-direction: row; height: 12px; margin: 6px 0 14px 0; }
.board__seg { flex-grow: 1; margin-right: 4px; border-radius: 4px; background-color: rgb(52, 60, 68); }
.board__seg--done { background-color: rgb(38, 217, 89); }
.board__seg--now { background-color: rgb(255, 174, 13); }
.board__actions { flex-direction: row; margin-top: auto; padding-top: 14px; }

.board__button {
    flex-grow: 1;
    height: 64px;
    margin: 0 6px 0 0;
    font-size: 22px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(52, 60, 68);
    color: rgb(240, 242, 244);
}

.board__button:hover { background-color: rgb(80, 90, 100); border-color: rgb(240, 242, 244); }
.board__button:active { background-color: rgb(110, 120, 130); }
.board__button--key { background-color: rgb(255, 174, 13); color: rgb(29, 22, 0); }
.board__button--key:hover { background-color: rgb(255, 196, 70); }

/* Training display (VrHud), on the tablet's screen: the task at hand, where to do it, the next one, the prompt */
.hud__label { font-size: 15px; -unity-font-style: bold; color: rgb(160, 168, 176); letter-spacing: 1px; }
.hud__current { font-size: 26px; -unity-font-style: bold; color: rgb(240, 242, 244); white-space: normal; margin: 2px 0 10px 0; }
.hud__where { font-size: 17px; color: rgb(255, 174, 13); white-space: normal; margin: -4px 0 10px 0; }
.hud__refusal { font-size: 17px; -unity-font-style: bold; color: rgb(255, 80, 64); white-space: normal; margin: 0 0 10px 0; }
.hud__next-row { margin-bottom: 10px; }
.hud__next { font-size: 18px; color: rgb(200, 206, 212); white-space: normal; margin-top: 2px; }
.hud__status { font-size: 17px; color: rgb(200, 206, 212); }
.hud__status--alert { color: rgb(255, 80, 64); -unity-font-style: bold; }
.hud__prompt { font-size: 17px; -unity-font-style: bold; color: rgb(255, 174, 13); margin-top: auto; padding-top: 8px; white-space: normal; border-top-width: 1px; border-top-color: rgb(52, 60, 68); }

/* The tablet in the left hand: a dark bezel, a screen, a status bar, the display beside the options */
.tablet {
    width: 100%;
    height: 100%;
    padding: 16px;
    background-color: rgb(14, 16, 18);
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(58, 62, 68);
}

.tablet__screen {
    flex-grow: 1;
    padding: 14px 16px 10px 16px;
    background-color: rgb(24, 28, 33);
    border-radius: 14px;
}

.tablet__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 60, 68);
}

.tablet__brand { font-size: 14px; -unity-font-style: bold; color: rgb(255, 174, 13); letter-spacing: 2px; }
.tablet__status { -unity-text-align: middle-right; max-width: 70%; white-space: normal; }
.tablet__body { flex-direction: row; flex-grow: 1; }
.tablet__display { flex-grow: 1; flex-basis: 0; padding-right: 16px; margin-right: 16px; border-right-width: 1px; border-right-color: rgb(52, 60, 68); }
.tablet__options { width: 290px; }
.tablet__row { flex-direction: row; }
.tablet__half { flex-grow: 1; flex-basis: 0; }
.tablet__half:first-child { margin-right: 6px; }
.tablet__wrap { flex-wrap: wrap; justify-content: space-between; }
.tablet__wrap > .tablet__half { flex-grow: 0; flex-basis: auto; width: 49%; margin-right: 0; }
.tablet__third { flex-grow: 1; flex-basis: 0; margin-right: 4px; }
.tablet__third:last-child { margin-right: 0; }
/* The fire drill page (VrFireMenu): more options, so compact buttons */
#fire-options .menu__button { height: 34px; margin: 2px 0; font-size: 15px; }
#fire-options .menu__group { margin: 6px 0 2px 0; font-size: 14px; }
.tablet__hint { font-size: 12px; color: rgb(120, 128, 136); -unity-text-align: middle-center; margin-top: 8px; }

/* The tablet's option buttons */
.menu__group { font-size: 16px; color: rgb(160, 168, 176); margin: 8px 0 4px 0; }

.menu__button {
    height: 44px;
    margin: 3px 0;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    background-color: rgb(52, 60, 68);
    color: rgb(240, 242, 244);
}

.menu__button:hover { background-color: rgb(80, 90, 100); border-width: 2px; border-color: rgb(240, 242, 244); }
.menu__button:active { background-color: rgb(110, 120, 130); }
.menu__button--key { background-color: rgb(255, 174, 13); color: rgb(29, 22, 0); }
.menu__button--key:hover { background-color: rgb(255, 196, 70); }
.menu__button--exit { background-color: rgb(120, 40, 34); }

/* Fire training station score board (FireScoreBoard, M15) */
.score__header { flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.score__trainee { font-size: 22px; color: rgb(240, 242, 244); -unity-font-style: bold; margin: 2px 0 0 0; padding: 0; }
.score__total-box { align-items: flex-end; }
.score__total { font-size: 64px; color: rgb(255, 196, 70); -unity-font-style: bold; margin: 0; padding: 0; }
.score__runs { font-size: 18px; color: rgb(160, 168, 176); margin: 0 0 10px 0; padding: 0; }
.score__badges { font-size: 22px; color: rgb(255, 196, 70); white-space: normal; margin: 2px 0 12px 0; padding: 0; }
.score__steps { font-size: 20px; color: rgb(220, 226, 232); white-space: normal; margin: 2px 0 8px 0; padding: 0; }
.score__news { font-size: 20px; color: rgb(54, 200, 120); -unity-font-style: bold; white-space: normal; margin: 0; padding: 0; }

/* Fire drill HUD (FireHud, M15): follows the view, low and ahead. */
.fhud { width: 100%; height: 100%; padding: 14px 20px; background-color: rgba(12, 14, 16, 0.86); border-radius: 18px; border-width: 2px; border-color: rgba(255, 174, 13, 0.55); }
.fhud__row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.fhud__top { justify-content: space-between; }
.fhud__stat { flex-direction: row; align-items: center; margin-right: 24px; }
.fhud__icon { width: 40px; height: 40px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(220, 226, 232); flex-shrink: 0; }
.fhud__icon--gold { -unity-background-image-tint-color: rgb(255, 196, 70); }
.fhud__score { font-size: 46px; -unity-font-style: bold; color: rgb(255, 196, 70); margin: 0; padding: 0; }
.fhud__unit { font-size: 18px; color: rgb(160, 168, 176); margin: 14px 0 0 6px; padding: 0; }
.fhud__timer { font-size: 34px; -unity-font-style: bold; color: rgb(240, 242, 244); margin: 0; padding: 0; }
.fhud__badges { flex-direction: row; flex-grow: 1; justify-content: flex-end; }
.fhud__badge { width: 46px; height: 46px; margin-left: 8px; -unity-background-scale-mode: scale-to-fit; }
.fhud__block { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; }
.fhud__block--ext { margin-left: 16px; }
.fhud__fire { font-size: 24px; -unity-font-style: bold; color: rgb(240, 242, 244); margin: 0; padding: 0; white-space: normal; }
.fhud__stage { font-size: 20px; color: rgb(255, 196, 70); margin: 2px 0 0 0; padding: 0; }
.fhud__stage--danger { color: rgb(255, 90, 80); -unity-font-style: bold; }
.fhud__ext { flex-grow: 1; }
.fhud__bar { height: 12px; margin-top: 6px; background-color: rgb(52, 60, 68); border-radius: 6px; overflow: hidden; }
.fhud__bar-fill { height: 100%; width: 0%; background-color: rgb(54, 200, 120); border-radius: 6px; }
.fhud__bar-fill--low { background-color: rgb(255, 90, 80); }
.fhud__distance { font-size: 19px; color: rgb(220, 226, 232); margin: 6px 0 0 0; padding: 0; }
.fhud__distance--good { color: rgb(80, 220, 140); -unity-font-style: bold; }
.fhud__distance--danger { color: rgb(255, 80, 64); -unity-font-style: bold; }
.fhud__steps { justify-content: space-between; margin-bottom: 6px; }
.fhud__step { flex-direction: row; align-items: center; padding: 4px 10px; border-radius: 14px; background-color: rgb(32, 37, 42); }
.fhud__step--done { background-color: rgba(54, 168, 108, 0.35); }
.fhud__step-icon { width: 24px; height: 24px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(120, 128, 136); }
.fhud__step--done .fhud__step-icon { -unity-background-image-tint-color: rgb(80, 220, 140); }
.fhud__step-text { font-size: 18px; color: rgb(170, 178, 186); margin: 0; padding: 0; }
.fhud__step--done .fhud__step-text { color: rgb(230, 240, 234); }
.fhud__advice { font-size: 22px; color: rgb(255, 196, 70); white-space: normal; margin: 0; padding: 0; -unity-text-align: middle-center; }

/* Badge chips (BadgeChips): the score board and the HUD */
.badge-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 4px 0 10px 0; }
.badge-chip { flex-direction: row; align-items: center; margin: 0 14px 6px 0; }
.badge-chip__icon { width: 38px; height: 38px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
.badge-chip__name { font-size: 18px; color: rgb(255, 196, 70); margin: 0; padding: 0; }
.fhud__badges .badge-chip { margin: 0 0 0 8px; }
.fhud__badges .badge-chip__icon { width: 44px; height: 44px; margin-right: 0; }
