/* World-space panels for the headset (M12): the training board, the HUD and the selection panel.
   Sizes are in panel pixels: 100 px is one unit, and each document's transform scale sets its real size (board 0.8 m). */
.hidden {
    display: none;
}

/* Training board above the line control station */
.board {
    width: 100%;
    height: 100%;
    padding: 24px 28px;
    background-color: rgba(20, 24, 28, 0.92);
    border-radius: 14px;
    border-left-width: 8px;
    border-left-color: rgb(255, 174, 13);
}

.board__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.board__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 242, 244);
}

.board__chip {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 4px 14px;
    border-radius: 14px;
    background-color: rgb(70, 78, 86);
    color: rgb(240, 242, 244);
}

.board__chip--ok { background-color: rgb(38, 217, 89); color: rgb(8, 24, 15); }
.board__chip--warn { background-color: rgb(255, 174, 13); color: rgb(29, 22, 0); }
.board__who { font-size: 20px; color: rgb(200, 206, 212); margin-bottom: 14px; }
.board__step { font-size: 22px; color: rgb(160, 168, 176); }
.board__next { font-size: 32px; -unity-font-style: bold; color: rgb(240, 242, 244); white-space: normal; margin: 4px 0 12px 0; }
.board__mistakes { font-size: 22px; color: rgb(160, 168, 176); }
.board__mistakes--some { color: rgb(255, 174, 13); }
.board__status { font-size: 22px; color: rgb(200, 206, 212); margin-top: 14px; }
.board__status--alert { color: rgb(255, 80, 64); -unity-font-style: bold; }

/* HUD that lazily follows the view */
.hud {
    width: 100%;
    height: 100%;
    padding: 12px 18px;
    background-color: rgba(20, 24, 28, 0.78);
    border-radius: 12px;
    justify-content: center;
}

.hud__status { font-size: 26px; -unity-font-style: bold; color: rgb(240, 242, 244); }
.hud__status--alert { color: rgb(255, 80, 64); }
.hud__step { font-size: 22px; color: rgb(200, 206, 212); white-space: normal; margin-top: 4px; }
.hud__prompt { font-size: 24px; -unity-font-style: bold; color: rgb(255, 174, 13); margin-top: 6px; }

/* Selection panel on the left controller */
.menu {
    width: 100%;
    height: 100%;
    padding: 14px;
    background-color: rgba(20, 24, 28, 0.92);
    border-radius: 14px;
}

.menu__title { font-size: 24px; -unity-font-style: bold; color: rgb(240, 242, 244); margin-bottom: 8px; }
.menu__group { font-size: 16px; color: rgb(160, 168, 176); margin: 8px 0 4px 0; }

.menu__button {
    height: 44px;
    margin: 3px 0;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    background-color: rgb(52, 60, 68);
    color: rgb(240, 242, 244);
}

.menu__button:hover { background-color: rgb(80, 90, 100); }
.menu__button:active { background-color: rgb(110, 120, 130); }
.menu__button--key { background-color: rgb(255, 174, 13); color: rgb(29, 22, 0); }
.menu__button--key:hover { background-color: rgb(255, 196, 70); }
.menu__button--exit { background-color: rgb(120, 40, 34); }
