/* Commissioning panel: the dashboard's panel style, on the left, sized to its rows. */

.vc-panel {
    left: 24px;
    right: auto;
    bottom: auto;
    width: 460px;
}

.vc-program {
    margin: -8px 0 10px 0;
}

.vc-rows {
    border-top-width: 1px;
    border-color: var(--line);
}

.vc-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 0;
    border-bottom-width: 1px;
    border-color: var(--line);
}

.vc-row__index {
    width: 22px;
    color: var(--muted);
    padding: 0;
    margin: 0;
}

.vc-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.vc-row__name {
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.vc-row__detail {
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.vc-row--current {
    background-color: var(--surface);
}

.vc-status--pending { background-color: var(--surface); color: var(--muted); }
.vc-status--running { background-color: rgba(242, 183, 5, 0.2); color: var(--warning); }
.vc-status--pass { background-color: var(--ok); color: rgb(8, 24, 15); }
.vc-status--fail { background-color: var(--fault); color: rgb(255, 255, 255); }
.vc-status--na { background-color: var(--surface); color: var(--muted); }

.vc-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}

.vc-summary {
    -unity-font-style: bold;
}

/* Code card: the PLC program's infeed interlock, read from the .st file under test. */

.vc-code {
    margin: 0 0 12px 0;
    padding: 10px 12px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: var(--warning);
}

.vc-code__file {
    font-size: 12px;
    color: var(--muted);
    padding: 0;
    margin: 0 0 4px 0;
}

.vc-code__line {
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    padding: 0;
    margin: 0;
}
