/* Desktop trainee HUD (M11): a crosshair at the centre and the prompt for the training point under it. */
.hidden {
    display: none;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hud__crosshair {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.hud__prompt {
    position: absolute;
    bottom: 12%;
    padding: 8px 16px;
    border-radius: 6px;
    background-color: rgba(18, 22, 26, 0.85);
    color: rgb(240, 242, 244);
    font-size: 18px;
    -unity-font-style: bold;
}
